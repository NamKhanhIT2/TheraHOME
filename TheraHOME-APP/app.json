{
  "expo": {
    "name": "TheraHOME",
    "slug": "therahome-mobile-app",
    "scheme": "therahome",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.therahome",
      "buildNumber": "46",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "TheraHOME cần quyền micro để bạn gọi thoại cho nhân viên chăm sóc khách hàng.",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "TheraHOME cần quyền camera để bạn gọi video với nhân viên chăm sóc khách hàng, và để chấm động tác tập của bạn ngay trên máy — hình ảnh không được tải lên hay lưu lại."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.therahome",
      "versionCode": 23,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0169ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "TheraHOME cần quyền truy cập thư viện ảnh để bạn thêm ảnh vào bài viết.",
          "cameraPermission": "TheraHOME cần quyền camera để bạn gọi video với nhân viên chăm sóc khách hàng, và để chấm động tác tập của bạn ngay trên máy — hình ảnh không được tải lên hay lưu lại.",
          "microphonePermission": "TheraHOME cần quyền micro để bạn gọi thoại cho nhân viên chăm sóc khách hàng."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#007FD9",
          "sounds": [
            "./assets/sounds/ting.wav"
          ]
        }
      ],
      "expo-video",
      "expo-image",
      "./plugins/withAndroidUploadSigning",
      "./plugins/withPlayAssetsBundleCopy",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brandmark-blue.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FC"
        }
      ],
      "expo-audio",
      "@livekit/react-native-expo-plugin",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.880262966797-l7r5e4bf6jlan3gdiqlj7kv09ggo2821"
        }
      ],
      "./plugins/withCallkeepLabel",
      "@config-plugins/react-native-callkeep",
      "./plugins/withVoipPushKit"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfa99e0f-0190-4b68-8079-a9644a70403c"
      },
      "googleSignIn": {
        "webClientId": "880262966797-72authj1p9s3s287nj5or005cickdj0u.apps.googleusercontent.com",
        "iosClientId": "880262966797-l7r5e4bf6jlan3gdiqlj7kv09ggo2821.apps.googleusercontent.com"
      }
    },
    "owner": "khanhnam"
  }
}
