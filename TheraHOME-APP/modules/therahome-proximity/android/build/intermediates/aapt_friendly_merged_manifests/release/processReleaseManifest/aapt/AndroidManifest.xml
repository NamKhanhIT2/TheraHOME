<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.therahome.proximity" >

    <uses-sdk android:minSdkVersion="24" />
    <!--
       The proximity lock is a wake lock, so it needs this. Declared here
       rather than only in app.json so the module carries its own
       requirement and cannot be broken by an edit to the app's list.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

</manifest>