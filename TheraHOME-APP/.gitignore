# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files (use .env.example as the template — never commit real .env)
.env
.env*.local

# Play Console service-account key used by `eas submit` (see eas.json's
# submit.production.android.serviceAccountKeyPath) — a real credential.
# `google-services.json` (Firebase/FCM) is NOT ignored: EAS builds from the
# git worktree and the Android build needs that file present.
google-play-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Build artefacts for the store — regenerable, and an AAB is ~110MB.
# The listing copy and screenshots next to it ARE tracked (see play-assets/).
*.aab
*.apk
# Account credentials the QA scripts generate on your machine — never commit.
scripts/testers-credentials.csv
scripts/android-qa-credentials.csv

# Local Expo module build output. The root /android and /ios are ignored
# already, but a module under modules/ builds into its own tree — and a
# `git add -A` after an Android build put 165 generated files (1.2MB of
# Gradle intermediates, .bin caches, merged resources) into a commit.
modules/*/android/build/
modules/*/ios/build/

# Pose track generator downloads its (9 MB) MediaPipe model on first run.
# The APP ships its own copy under modules/therahome-pose/android/.../assets;
# this one is only for scripts/pose-track.py on a Mac.
scripts/.models/

# The browser harness is built from source on demand (scripts/pose-preview/
# build.mjs) and carries a copy of a reference clip. Nothing in it is source.
scripts/pose-preview/dist/
